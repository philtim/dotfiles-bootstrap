#!/usr/bin/env bash
# Fresh-machine bootstrap. Lives in a SEPARATE public repo
# (philtim/dotfiles-bootstrap) as just `bootstrap` + README.
#
# Usage (paste into Terminal on a fresh Mac or Omarchy install):
#   curl -fsSL https://raw.githubusercontent.com/philtim/dotfiles-bootstrap/main/bootstrap | bash
#
# Steps:
#   1. Detect OS (Darwin or Arch-based Linux).
#   2. Mac: xcode-select wait, Homebrew, brew install gh.
#      Omarchy: pacman -S git github-cli.
#   3. gh auth login --web (browser-based; no PATs in URL).
#   4. gh repo clone philtim/dotfiles into ~/.dotfiles.
#   5. exec setup.sh

set -e
REPO="philtim/dotfiles"
DEST="$HOME/.dotfiles"

OS="$(uname)"

if [[ "$OS" == "Darwin" ]]; then
    # ---------- macOS ------------------------------------------------------
    if ! xcode-select -p &>/dev/null; then
        echo "==> Installing Xcode command line tools (click through the GUI dialog)..."
        xcode-select --install
        until xcode-select -p &>/dev/null; do
            echo "    (still waiting — approve the install dialog)"
            sleep 20
        done
    fi

    if ! command -v brew &>/dev/null; then
        echo "==> Installing Homebrew..."
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        BREW_PREFIX=$([[ $(uname -m) == arm64 ]] && echo /opt/homebrew || echo /usr/local)
        eval "$($BREW_PREFIX/bin/brew shellenv)"
    fi

    if ! command -v gh &>/dev/null; then
        echo "==> Installing GitHub CLI..."
        brew install gh
    fi

elif [[ "$OS" == "Linux" ]]; then
    # ---------- Linux / Arch (Omarchy) ------------------------------------
    if [[ ! -r /etc/os-release ]]; then
        echo "Cannot detect Linux distro (/etc/os-release missing)." >&2
        exit 1
    fi
    . /etc/os-release
    if [[ "${ID:-}" != "arch" && " ${ID_LIKE:-} " != *" arch "* ]]; then
        echo "Unsupported Linux distro: ID=${ID:-?}. Only Arch-based (Omarchy) is supported." >&2
        exit 1
    fi

    echo "==> Installing git + github-cli via pacman..."
    sudo pacman -S --needed --noconfirm git github-cli

else
    echo "Unsupported OS: $OS" >&2
    exit 1
fi

# ---------- Shared: gh auth + clone ---------------------------------------
if ! gh auth status &>/dev/null; then
    echo "==> Signing in to GitHub (browser will open)..."
    # Under `curl ... | bash`, stdin is the pipe, not the terminal — but
    # gh's --web flow reads a "press Enter" confirmation from stdin.
    # Reattach stdin to the controlling terminal so it doesn't hang/abort.
    gh auth login --hostname github.com --git-protocol https --web </dev/tty
fi

if [[ ! -d "$DEST" ]]; then
    echo "==> Cloning $REPO into $DEST..."
    gh repo clone "$REPO" "$DEST" -- --recurse-submodules
else
    # Re-running the curl one-liner on a machine where ~/.dotfiles already
    # exists should pick up upstream fixes, not silently run the stale local
    # copy. Pull --ff-only on main; refuse to touch any other branch so
    # in-progress work isn't clobbered.
    current_branch=$(git -C "$DEST" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ "$current_branch" == "main" ]]; then
        echo "==> $DEST exists on main — fast-forwarding to latest..."
        git -C "$DEST" pull --ff-only origin main || \
            echo "    (could not fast-forward; continuing with current state)"
    else
        echo "==> $DEST exists on branch '$current_branch' — leaving untouched"
    fi
fi

# Idempotent: tpm (tmux plugin manager) is tracked as a submodule. Initialize
# it here so setup.sh can stow tmux without referencing an empty directory.
# Safe to re-run even when up-to-date.
echo "==> Ensuring git submodules are initialized..."
git -C "$DEST" submodule update --init --recursive

echo "==> Handing off to $DEST/setup.sh..."
cd "$DEST"
exec ./setup.sh
